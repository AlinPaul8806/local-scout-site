---
interface Props {
  name: string;
  role: string;
  photoUrl?: string;
  description: string;
  scoutName?: string;
}

const { name, role, photoUrl = '/scout-watermark.png', description, scoutName } = Astro.props;
---

<details class="group/leader border border-white/5 bg-stone-900/40 rounded-xl overflow-hidden transition-all duration-300">
  <summary class="flex items-center justify-between p-3.5 cursor-pointer hover:bg-white/5 list-none select-none text-xs sm:text-sm font-semibold">
    <div class="flex items-center gap-3">
      <img src={photoUrl} alt={name} class="w-8 h-8 rounded-full border border-white/10 object-cover bg-stone-950" />
      <div>
        <span class="text-white block font-bold">
          {name} {scoutName && <span class="text-amber-400 font-medium font-mono text-[11px]">({scoutName})</span>}
        </span>
        <span class="text-stone-400 text-[11px] block mt-0.5">{role}</span>
      </div>
    </div>
    <svg xmlns="http://w3.org" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-stone-400 transition-transform duration-200 group-open/leader:rotate-180">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </summary>

  <div class="p-6 border-t border-white/5 bg-stone-950/20 flex flex-col items-center gap-6 text-xs sm:text-sm leading-relaxed text-stone-300">
    <div class="w-64 h-64 sm:w-80 sm:h-80 shrink-0 rounded-2xl border border-white/10 overflow-hidden shadow-2xl bg-stone-950 select-none">
      <img src={photoUrl} alt={name} class="w-full h-full object-cover" />
    </div>

    <div class="w-full text-justify [&>p]:indent-8 space-y-3">
      <div set:html={description} />
    </div>
  </div>
</details>
