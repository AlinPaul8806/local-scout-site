---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ro" class="bg-transparent text-stone-800 scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Website oficial - Centrul Local Baden Powell București" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col font-sans antialiased">
		<nav class="bg-[#124d37] text-white shadow-md sticky top-0 z-50 transition-all duration-300 border-b-4 border-scout-gold">
			<div class="max-w-6xl mx-auto px-4">
				<div class="flex items-center justify-between gap-4 py-0 w-full overflow-hidden">
					<div class="flex-shrink-0 w-16 h-16 sm:w-25 sm:h-25 flex items-center justify-center">
						<img
							src="/scout-watermark.png"
							alt="Organizația Națională Cercetașii României Emblemă"
							class="max-w-full max-h-full object-contain block"
							loading="eager"
						/>
					</div>

					<div class="flex-grow flex flex-col items-center text-center leading-tight px-2 min-w-0">
						<span class="text-sm sm:text-base md:text-lg font-extrabold uppercase tracking-wider text-white">
							Organizația Națională CERCETAȘII ROMÂNIEI
						</span>
						<span class="text-xs sm:text-sm font-semibold text-white/80 tracking-wide mt-0.5 sm:mt-1">
							Centrul Local Baden-Powell București
						</span>
					</div>

					<a href="/" class="flex-shrink-0 w-14 h-14 sm:w-20 sm:h-20 flex items-center justify-center group" aria-label="Acasă">
						<img
							src="/logobp.png"
							alt="Logo Baden Powell"
							class="max-w-full max-h-full object-contain bg-white/10 rounded-full p-1 group-hover:bg-white/20 transition-all block"
						/>
					</a>
				</div>

				<div class="w-full h-px bg-white/10 p-0 m-0"></div>

				<div class="flex flex-col sm:flex-row gap-4 pt-2 pb-3 items-center justify-between text-sm font-medium">
					<div class="flex flex-wrap items-center justify-center gap-4 md:gap-8">
						<a href="/" class="hover:text-amber-400 transition-colors py-1">Acasă</a>

						<div class="relative group py-1 cursor-pointer">
							<a href="/cine-suntem" class="hover:text-amber-400 transition-colors flex items-center gap-1">
								Cine suntem
								<svg xmlns="http://w3.org" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
							</a>
							<div class="absolute left-0 mt-1 w-40 bg-stone-900 border border-white/10 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 flex flex-col p-1.5 overflow-hidden">
								<a href="/echipa" class="text-xs text-stone-200 hover:text-amber-400 hover:bg-white/5 px-3 py-2 rounded-lg transition-colors font-medium">Echipa</a>
								<a href="/inceputuri" class="text-xs text-stone-200 hover:text-amber-400 hover:bg-white/5 px-3 py-2 rounded-lg transition-colors font-medium">Inceputuri</a>
							</div>
						</div>

						<div class="relative group py-1 cursor-pointer">
							<span class="hover:text-amber-400 transition-colors flex items-center gap-1 text-white">
								Campuri & Activități
								<svg xmlns="http://w3.org" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
							</span>
							<div class="absolute left-0 mt-1 w-42 bg-stone-900 border border-white/10 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 flex flex-col p-1.5 overflow-hidden">
								<a href="/campuri" class="text-xs text-stone-200 hover:text-amber-400 hover:bg-white/5 px-3 py-2 rounded-lg transition-colors font-medium">Campuri</a>
								<a href="/activitati" class="text-xs text-stone-200 hover:text-amber-400 hover:bg-white/5 px-3 py-2 rounded-lg transition-colors font-medium">Activități</a>
								<a href="/evenimente-de-traditie" class="text-xs text-stone-200 hover:text-amber-400 hover:bg-white/5 px-3 py-2 rounded-lg transition-colors font-medium">Evenimente de tradiție</a>
							</div>
						</div>

						<a href="/parteneri" class="hover:text-amber-400 transition-colors py-1">Sponsori & Parteneri</a>
					</div>

					<div class="flex items-center gap-4 flex-wrap justify-center">
						<a href="/contact" class="hover:text-amber-400 transition-colors font-semibold border border-white/20 hover:border-amber-400/40 px-4 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 transition-all text-xs uppercase tracking-wider">
							Contact & Sponsorizări
						</a>

						<div class="flex items-center gap-3 pl-4 border-l border-white/20">
							<a href="https://www.facebook.com/clbadenpowell.oncr" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors p-1" aria-label="Facebook Pagina Oficială">
								<svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4.5 h-4.5">
									<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
								</svg>
							</a>

							<a href="https://www.instagram.com/centrul_local_baden_powell?mdxt=aTZtaHVyNTJmY2w4" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors p-1" aria-label="Instagram Pagina Oficială">
								<svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4.5 h-4.5">
									<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
									<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
									<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
								</svg>
							</a>

							<a href="https://www.tiktok.com/@centrulocal_badenpowell?_r=1&_t=ZN-9AdmPdI29Mk" target="_blank" rel="noopener noreferrer" class="hover:text-amber-400 transition-colors p-1" aria-label="TikTok Pagina Oficială">
								<svg xmlns="http://w3.org" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4.5 h-4.5">
									<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
								</svg>
							</a>
						</div>
					</div>
				</div>
			</div>
		</nav>

		<main class="flex-grow max-w-6xl mx-auto px-4 py-8 w-full">
			<slot />
		</main>

		<footer class="bg-[#124d37] text-white/80 text-sm py-8 mt-auto border-t-4 border-scout-gold">
			<div class="max-w-6xl mx-auto px-4 text-center space-y-3">
				<div class="space-y-1">
					<p class="font-semibold text-white">Centrul Local Baden Powell București</p>
					<p>© {new Date().getFullYear()} Cercetașii României. Gata Oricând!</p>
				</div>

				<div class="text-xs text-white/60 pt-2 border-t border-white/10 max-w-xs mx-auto">
					<p class="flex items-center justify-center gap-1.5">
						Made with ❤️ by
						<a
							href="https://www.linkedin.com/in/alin-paul-popa-b4272258/?locale=en"
							target="_blank"
							rel="noopener noreferrer" 
							class="text-scout-gold hover:text-white font-medium underline underline-offset-4 decoration-scout-gold/30 hover:decoration-white transition-colors duration-200 ml-1"
							title="Vizitează profilul de LinkedIn al autorului"
						>
							Alin-Paul Popa
						</a>
					</p>
				</div>

			</div>
		</footer>
	</body>
</html>
