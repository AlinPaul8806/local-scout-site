              </button>
            </div>
          </div>
        </div>

        <div class="bg-stone-900/75 backdrop-blur-xl border border-amber-500/20 rounded-2xl p-6 shadow-2xl space-y-3">
          <h3 class="font-bold text-amber-400 text-base flex items-center gap-1.5">📝 Redirecționează 3.5%</h3>
          <p class="text-stone-200 text-xs leading-relaxed">
            Dacă ești salariat, poți direcționa gratuit 3.5% din impozitul pe venit completând Formularul 230 în beneficiul centrului nostru local, sprijinind materialele de tabără ale copiilor.
          </p>
          <a href="#" onclick="alert('Descărcare formular precompletat 230...'); return false;" class="inline-block text-xs font-bold text-amber-900 border border-amber-900/20 bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 uppercase tracking-wider px-4 py-2.5 rounded-lg transition-all shadow-sm">
            Descarcă Formularul 230 PDF ↓
          </a>
        </div>

      </div>
    </div>
  </div>
</Layout>

<style is:global>
  body {
    background-color: #1a1917 !important;
    position: relative;
    overflow-x: hidden;
  }

  body::before {
    content: "" !important;
    background-image: none !important;
    background-color: transparent !important;
    position: fixed;
    inset: 0;
    z-index: -3;
  }

  body::after {
    content: "";
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 95vw;
    height: 95vh;
    max-width: 1200px;
    max-height: 900px;
    background-image: url('/about-scarf.png');
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    pointer-events: none;
    z-index: -1;
    opacity: 0.7;
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-iban-btn');
  const ibanTextEl = document.getElementById('iban-text');
  const statusBadge = document.getElementById('copy-status-badge');
  const form = document.getElementById('contact-form');
  const formStatus = document.getElementById('form-status');
  const honeypot = document.getElementById('website');
  const submitBtn = form ? form.querySelector('button[type="submit"]') : null;

  function setFormStatus(message, isError = false) {
    if (!formStatus) return;

    formStatus.textContent = message;
    formStatus.classList.toggle('hidden', !message);
    formStatus.classList.toggle('border-amber-500/30', !isError);
    formStatus.classList.toggle('bg-amber-500/10', !isError);
    formStatus.classList.toggle('text-amber-200', !isError);
    formStatus.classList.toggle('border-red-500/30', isError);
    formStatus.classList.toggle('bg-red-500/10', isError);
    formStatus.classList.toggle('text-red-200', isError);
  }

  if (form && submitBtn) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const name = (form.querySelector('input[name="name"]') || {}).value || '';
      const email = (form.querySelector('input[name="email"]') || {}).value || '';
      const subject = (form.querySelector('select[name="subject"]') || {}).value || '';
      const message = (form.querySelector('textarea[name="message"]') || {}).value || '';

      if (honeypot && honeypot.value.trim()) {
        setFormStatus('Mesajul a fost respins ca spam.', true);
        return;
      }

      if (name.trim().length < 2) {
        setFormStatus('Te rugăm să introduci un nume valid.', true);
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.trim())) {
        setFormStatus('Te rugăm să introduci o adresă de e-mail validă.', true);
        return;
      }

      if (!subject.trim()) {
        setFormStatus('Te rugăm să alegi un subiect.', true);
        return;
      }

      if (message.trim().length < 20) {
        setFormStatus('Mesajul trebuie să aibă cel puțin 20 de caractere.', true);
        return;
      }

      const cooldownKey = 'contact-form-cooldown';
      const cooldownMs = 5000;
      const lastSubmittedAt = Number(localStorage.getItem(cooldownKey) || '0');
      const now = Date.now();

      if (lastSubmittedAt && now - lastSubmittedAt < cooldownMs) {
        const remainingSeconds = Math.ceil((cooldownMs - (now - lastSubmittedAt)) / 1000);
        setFormStatus(`Te rugăm să aștepți ${remainingSeconds}s înainte de a trimite din nou.`, true);
        return;
      }

      localStorage.setItem(cooldownKey, String(now));
      submitBtn.disabled = true;
      submitBtn.textContent = 'Se trimite...';
      setFormStatus('Se trimite mesajul...', false);
      form.submit();
    });
  }

  if (copyBtn && ibanTextEl && statusBadge) {
    copyBtn.addEventListener('click', async () => {
      const rawIban = ibanTextEl.textContent || '';

      try {
        await navigator.clipboard.writeText(rawIban);

        statusBadge.textContent = 'COPIAT! ✓';
        statusBadge.classList.remove('bg-stone-900', 'text-stone-300');
        statusBadge.classList.add('bg-emerald-600', 'text-white');
        copyBtn.classList.add('border-emerald-500');

        setTimeout(() => {
          statusBadge.textContent = 'COPIAZĂ';
          statusBadge.classList.remove('bg-emerald-600', 'text-white');
          statusBadge.classList.add('bg-stone-900', 'text-stone-300');
          copyBtn.classList.remove('border-emerald-500');
        }, 2000);

      } catch (err) {
        console.error('Eroare la copierea textului: ', err);
      }
    });
  }
</script>
